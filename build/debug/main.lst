 168:Core/Src/main.c **** void PrintRealTimeUnion(UART_HandleTypeDef* huart, NOS_RealTime_Union* rt)
 169:Core/Src/main.c **** {
 170:Core/Src/main.c ****   char message[20];
 171:Core/Src/main.c **** 
 172:Core/Src/main.c ****   message[0] = (rt->particles[Month] / 10) + 48;
 173:Core/Src/main.c ****   message[1] = (rt->particles[Month] % 10) + 48;
 174:Core/Src/main.c ****   message[2] = '/';
 175:Core/Src/main.c ****   message[3] = (rt->particles[Days] / 10) + 48;
 176:Core/Src/main.c ****   message[4] = (rt->particles[Days] % 10) + 48;
 177:Core/Src/main.c ****   message[5] = '/';
 178:Core/Src/main.c ****   message[6] = (rt->particles[Year] / 10) + 48;
 179:Core/Src/main.c ****   message[7] = (rt->particles[Year] % 10) + 48;
 180:Core/Src/main.c ****   message[8] = ' ';
 181:Core/Src/main.c ****   message[9] = (rt->particles[Hours] / 10) + 48;
 182:Core/Src/main.c ****   message[10] = (rt->particles[Hours] % 10) + 48;
 183:Core/Src/main.c ****   message[11] = '/';
 184:Core/Src/main.c ****   message[12] = (rt->particles[Minutes] / 10) + 48;
 185:Core/Src/main.c ****   message[13] = (rt->particles[Minutes] % 10) + 48;
 186:Core/Src/main.c ****   message[14] = '/';
 187:Core/Src/main.c ****   message[15] = (rt->particles[Seconds] / 10) + 48;
 188:Core/Src/main.c ****   message[16] = (rt->particles[Seconds] % 10) + 48;
 189:Core/Src/main.c ****   message[17] = ' ';
 190:Core/Src/main.c ****   message[18] = '\n';
 191:Core/Src/main.c ****   message[19] = '\0';
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****   HAL_UART_Transmit(huart,message,20,1000);
 194:Core/Src/main.c **** }
