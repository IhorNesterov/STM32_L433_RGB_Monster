 169:Core/Src/main.c **** void PrintRealTimeUnion(UART_HandleTypeDef* huart, NOS_RealTime_Union* rt)
 170:Core/Src/main.c **** {
 171:Core/Src/main.c ****   char message[20];
 172:Core/Src/main.c **** 
 173:Core/Src/main.c ****   message[0] = (rt->particles[Month] / 10) + 48;
 174:Core/Src/main.c ****   message[1] = (rt->particles[Month] % 10) + 48;
 175:Core/Src/main.c ****   message[2] = '/';
 176:Core/Src/main.c ****   message[3] = (rt->particles[Days] / 10) + 48;
 177:Core/Src/main.c ****   message[4] = (rt->particles[Days] % 10) + 48;
 178:Core/Src/main.c ****   message[5] = '/';
 179:Core/Src/main.c ****   message[6] = (rt->particles[Year] / 10) + 48;
 180:Core/Src/main.c ****   message[7] = (rt->particles[Year] % 10) + 48;
 181:Core/Src/main.c ****   message[8] = ' ';
 182:Core/Src/main.c ****   message[9] = (rt->particles[Hours] / 10) + 48;
 183:Core/Src/main.c ****   message[10] = (rt->particles[Hours] % 10) + 48;
 184:Core/Src/main.c ****   message[11] = '/';
 185:Core/Src/main.c ****   message[12] = (rt->particles[Minutes] / 10) + 48;
 186:Core/Src/main.c ****   message[13] = (rt->particles[Minutes] % 10) + 48;
 187:Core/Src/main.c ****   message[14] = '/';
 188:Core/Src/main.c ****   message[15] = (rt->particles[Seconds] / 10) + 48;
 189:Core/Src/main.c ****   message[16] = (rt->particles[Seconds] % 10) + 48;
 190:Core/Src/main.c ****   message[17] = ' ';
 191:Core/Src/main.c ****   message[18] = '\n';
 192:Core/Src/main.c ****   message[19] = '\0';
 193:Core/Src/main.c **** 
 194:Core/Src/main.c ****   HAL_UART_Transmit(huart,message,20,1000);
 195:Core/Src/main.c **** }
